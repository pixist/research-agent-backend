# Copy to .env and fill in. With no key set, the service runs a deterministic
# offline provider so you can try the UI without spending anything.

# --- Chat provider (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# --- Embedding provider ---
# Defaults to the chat provider. OpenRouter has no embeddings endpoint, so if
# chat points at OpenRouter, set these to a provider that can embed (or leave
# them and embeddings use the offline hash).
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=text-embedding-3-small

# --- Using OpenRouter for chat ---
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=openai/gpt-4o-mini      # any model id OpenRouter serves
# EMBED_API_KEY=sk-...               # an OpenAI key, so retrieval still works
# EMBED_BASE_URL=https://api.openai.com/v1
